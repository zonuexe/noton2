{
  "name": "noton2",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 execute noton2-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute noton2-db --remote --file=./schema.sql",
    "cf": "cf"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "vue": "3.6.0-rc.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "cf": "1.0.0-beta.27",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-jsx-vapor": "^3.2.29",
    "wrangler": "^4.157.0"
  }
}
